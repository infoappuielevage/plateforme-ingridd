# ⚠️ IMPORTANT (revue de sécurité) : les 2 valeurs ci-dessous (APP_ENV,
# APP_DEBUG) conviennent pour travailler en local (XAMPP/Laragon sur ce
# poste), mais JAMAIS pour un serveur réellement accessible depuis Internet
# (hébergement mutualisé, VPS...). Le jour où cette plateforme est déployée
# sur un tel serveur, changez-les en :
#   APP_ENV=production
#   APP_DEBUG=false
# Sinon, toute erreur affiche publiquement le détail technique complet (code
# source, requêtes SQL, chemins serveur...) à n'importe quel visiteur — une
# fuite d'information grave sur une plateforme qui héberge des dossiers
# étudiants confidentiels. Pensez aussi à SESSION_SECURE_COOKIE ci-dessous.
APP_NAME="INGRIDD — Archives & Documents"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (recommandé — voir "Choix techniques" dans README.md) : créez
# d'abord la base ("CREATE DATABASE plateforme_ingridd CHARACTER SET utf8mb4
# COLLATE utf8mb4_unicode_ci;" depuis phpMyAdmin/HeidiSQL ou la ligne de
# commande), puis ajustez les identifiants ci-dessous si besoin (ceux-ci sont
# les valeurs par défaut de Laragon/XAMPP/WampServer en local).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plateforme_ingridd
DB_USERNAME=root
DB_PASSWORD=

# SQLite (alternative sans serveur à installer) : décommentez les 5 lignes
# ci-dessous et commentez le bloc MySQL au-dessus.
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
#
# À n'activer que si database.sqlite est HORS de tout dossier synchronisé par
# OneDrive/Google Drive/Dropbox (voir config/database.php) — sinon, erreur
# "disk I/O error" dès la connexion à la base.
# DB_SQLITE_JOURNAL_MODE=wal
# DB_SQLITE_SYNCHRONOUS=normal

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# false en local (le site tourne en http://localhost, sans HTTPS) — mais à
# mettre à "true" dès que la plateforme est accessible en HTTPS (un
# hébergement public sérieux doit TOUJOURS en proposer) : sinon, le cookie
# de session continue de circuler en clair même une fois HTTPS disponible.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
